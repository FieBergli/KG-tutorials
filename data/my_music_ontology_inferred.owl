<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/music_ontology.owl"
         xmlns="http://example.org/music_ontology.owl#">

<owl:Ontology rdf:about="http://example.org/music_ontology.owl"/>

<owl:ObjectProperty rdf:about="#hasArtist">
  <rdfs:domain rdf:resource="#Album"/>
  <rdfs:range rdf:resource="#Artist"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasArtistSong">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="#Artist"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#createdBy">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="#Artist"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#writtenBy">
  <rdfs:subPropertyOf rdf:resource="#createdBy"/>
  <owl:inverseOf rdf:resource="#authorOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isOfAlbum">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="#Album"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isOfGenre">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="#Genre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#collaboratesWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Artist"/>
  <rdfs:range rdf:resource="#Artist"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#authorOf">
  <rdfs:domain rdf:resource="#Artist"/>
  <rdfs:range rdf:resource="#Song"/>
  <owl:inverseOf rdf:resource="#writtenBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFan">
  <rdfs:domain rdf:resource="#Artist"/>
  <rdfs:range rdf:resource="#Person"/>
  <owl:inverseOf rdf:resource="#isFanOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isFanOf">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Artist"/>
  <owl:inverseOf rdf:resource="#hasFan"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#albumName">
  <rdfs:subPropertyOf rdf:resource="#hasName"/>
  <rdfs:domain rdf:resource="#Album"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#artistName">
  <rdfs:subPropertyOf rdf:resource="#hasName"/>
  <rdfs:domain rdf:resource="#Artist"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#albumID">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Album"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#followers">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Artist"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Album">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Artist">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Song">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#writtenBy"/>
      <owl:onClass rdf:resource="#Artist"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Genre">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SubGenre">
  <rdfs:subClassOf rdf:resource="#Genre"/>
</owl:Class>

<owl:Class rdf:about="#SoloArtist">
  <rdfs:subClassOf rdf:resource="#Artist"/>
</owl:Class>

<owl:Class rdf:about="#ArtistType">
  <rdfs:subClassOf rdf:resource="#Artist"/>
</owl:Class>

<owl:Class rdf:about="#CollaboratingArtist">
  <rdfs:subClassOf rdf:resource="#Artist"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Artist"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#collaboratesWith"/>
          <owl:someValuesFrom rdf:resource="#Artist"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#SZA">
  <rdf:type rdf:resource="#Artist"/>
  <collaboratesWith rdf:resource="#Drake"/>
  <collaboratesWith rdf:resource="#miss_lauren_hill"/>
  <rdf:type rdf:resource="#CollaboratingArtist"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SOS">
  <rdf:type rdf:resource="#Album"/>
  <hasArtist rdf:resource="#SZA"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#kill_bill">
  <rdf:type rdf:resource="#Song"/>
  <writtenBy rdf:resource="#SZA"/>
  <isOfAlbum rdf:resource="#SOS"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#miss_lauren_hill">
  <rdf:type rdf:resource="#Artist"/>
  <rdf:type rdf:resource="#CollaboratingArtist"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Drake">
  <rdf:type rdf:resource="#SoloArtist"/>
  <rdf:type rdf:resource="#CollaboratingArtist"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Fie">
  <rdf:type rdf:resource="#Person"/>
  <isFanOf rdf:resource="#SZA"/>
</owl:NamedIndividual>


</rdf:RDF>
